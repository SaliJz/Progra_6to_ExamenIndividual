  m_TableData:
  - m_Id: 865517830144
    m_Localized: Despiertas en una taberna cuando un aldeano pide ayuda.
    m_Metadata:
      m_Items: []
  - m_Id: 897566507008
    m_Localized: Ayudar al aldeano
    m_Metadata:
      m_Items: []
  - m_Id: 973164642304
    m_Localized: Ignorarlo y seguir solo
    m_Metadata:
      m_Items: []
  - m_Id: 1009906745344
    m_Localized: Te internas en el bosque y una criatura salta desde la maleza.
    m_Metadata:
      m_Items: []
  - m_Id: 1042253217792
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 1091007807488
    m_Localized: "Las ruinas antiguas emiten una energ\xEDa oscura."
    m_Metadata:
      m_Items: []
  - m_Id: 1118186897408
    m_Localized: Entrar a las ruinas
    m_Metadata:
      m_Items: []
  - m_Id: 1161031712768
    m_Localized: "Un nigromante protege el coraz\xF3n de la ruina."
    m_Metadata:
      m_Items: []
  - m_Id: 1199854190592
    m_Localized: Derrotas al nigromante y salvas la aldea.
    m_Metadata:
      m_Items: []
  - m_Id: 1239788158976
    m_Localized: "Ca\xEDste en la oscuridad antes de completar tu misi\xF3n."
    m_Metadata:
      m_Items: []
