  m_TableData:
  - m_Id: 865517830144
    m_Localized: 'You wake up in a tavern when a villager asks for help. '
    m_Metadata:
      m_Items: []
  - m_Id: 897566507008
    m_Localized: 'Help the villager '
    m_Metadata:
      m_Items: []
  - m_Id: 973164642304
    m_Localized: 'Ignore him and go alone '
    m_Metadata:
      m_Items: []
  - m_Id: 1009906745344
    m_Localized: 'You enter the forest and a creature jumps from the bushes. '
    m_Metadata:
      m_Items: []
  - m_Id: 1042253217792
    m_Localized: 'Continue '
    m_Metadata:
      m_Items: []
  - m_Id: 1091007807488
    m_Localized: 'The ancient ruins emit a dark energy. '
    m_Metadata:
      m_Items: []
  - m_Id: 1118186897408
    m_Localized: 'Enter the ruins '
    m_Metadata:
      m_Items: []
  - m_Id: 1161031712768
    m_Localized: 'A necromancer guards the heart of the ruins. '
    m_Metadata:
      m_Items: []
  - m_Id: 1199854190592
    m_Localized: 'You defeat the necromancer and save the village. '
    m_Metadata:
      m_Items: []
  - m_Id: 1239788158976
    m_Localized: 'You fell into darkness before completing your quest. '
    m_Metadata:
      m_Items: []
